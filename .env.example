VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional local visual fixture only. Never enable in production.
VITE_DEMO_MODE=false

# SMTP password for auth.email.smtp in supabase/config.toml (Resend API key).
# Only needed when running `supabase start`/`config push`. Never commit real
# values and never expose this as a VITE_* variable.
RESEND_API_KEY=re_your-api-key
